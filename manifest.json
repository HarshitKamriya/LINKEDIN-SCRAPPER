{
  "manifest_version": 3,

  "name": "LinkedIn Scraper",
  "description": "Scrapes LinkedIn Recruiter profiles and exports the collected data. Created by Harshit Kamriya.",
  "version": "1.2",
  "version_name": "1.2.0",

  "permissions": ["storage", "activeTab", "scripting", "offscreen"],
  "host_permissions": ["https://www.linkedin.com/*"],

  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "run_at": "document_end",
      "matches": ["https://www.linkedin.com/recruiter/smartsearch*"],
      "js": ["linkedin_list.js", "jquery-3.4.1.min.js"]
    },
    {
      "run_at": "document_end",
      "matches": ["https://www.linkedin.com/recruiter/profile/*"],
      "js": ["linkedin_profile.js", "jquery-3.4.1.min.js"]
    }
  ]
}
